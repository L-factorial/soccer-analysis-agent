# Optional post-planning commentary prototype. The simulation works normally
# when this is false or when no API key is configured.
SOCCER_COMMENTARY_ENABLED=false
SOCCER_COMMENTARY_MODEL=gpt-5.6-luna
SOCCER_COMMENTARY_TIMEOUT_SECONDS=15
OPENAI_API_KEY=

# RAG embedding configuration. These settings are unused until an ingestion
# workflow invokes the embedding provider.
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_TIMEOUT_SECONDS=15
RAG_INGESTION_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=soccer_knowledge

# Comma-separated browser frontend origins, without trailing slashes.
# When unset, the backend allows the local Expo development origins.
# CORS_ALLOW_ORIGINS=https://app.example.com,http://localhost:8081
